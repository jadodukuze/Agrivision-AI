APP_NAME=AgriVision AI
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000

# Local development can use SQLite. For MySQL, use:
# mysql+pymysql://USER:PASSWORD@HOST:3306/agrivision_ai?charset=utf8mb4
DATABASE_URL=sqlite:///./agrivision_dev.db

# REQUIRED in production: generate a long random secret and keep it private.
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=60

# Comma-separated trusted frontend origins; never use * with credentials.
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Optional: create the first admin account once on startup when both are set.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_FULL_NAME=AgriVision Administrator

# Use persistent private storage in deployment.
UPLOAD_DIR=./storage/uploads
